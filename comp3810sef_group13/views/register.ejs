<%- include('partials/header', { title: 'Register', bodyClass: 'auth-body', mainClass: 'auth-main' }) %>

<div class="auth-card">
  <h1>Create account</h1>
  <p class="muted">Your tasks are only visible to you.</p>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <form method="POST" action="/register" class="stack">
    <label class="field">
      <span>Username</span>
      <input name="username" value="<%= locals.values.username || '' %>" placeholder="3-20 letters, digits or _" autocomplete="username" required autofocus>
    </label>
    <label class="field">
      <span>Display name</span>
      <input name="name" value="<%= locals.values.name || '' %>" placeholder="e.g. Demo User" autocomplete="name">
    </label>
    <label class="field">
      <span>Password</span>
      <input type="password" name="password" placeholder="At least 6 characters" autocomplete="new-password" required>
    </label>
    <label class="field">
      <span>Confirm password</span>
      <input type="password" name="confirm" autocomplete="new-password" required>
    </label>
    <button class="btn btn-primary btn-block" type="submit">Create account</button>
  </form>

  <p class="muted">Already have an account? <a href="/login">Sign in</a></p>
</div>

<%- include('partials/footer') %>
